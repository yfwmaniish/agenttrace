{
  "name": "@yfwdecimal/api",
  "version": "0.1.0",
  "description": "Fastify REST API — append-only trace ingestion, verification, compliance export",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@yfwdecimal/core": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0"
  }
}
